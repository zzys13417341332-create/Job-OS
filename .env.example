# ============================================
# Job OS 环境变量说明（全部可选）
# ============================================

# 【真实 AI 接入】在服务端配置以下变量后，
# API Key 只存在服务端，绝不会进入前端代码 / 浏览器。
# AI_API_KEY=
# AI_BASE_URL=https://api.openai.com/v1
# AI_MODEL=gpt-4.1-mini

# 【AI 模式】默认 mock（浏览器本地启发式分析，不发送任何数据）
# 设为 server 后，前端会把请求转发到 /api/ai/* 并调用真实 LLM。
# NEXT_PUBLIC_AI_MODE=mock
